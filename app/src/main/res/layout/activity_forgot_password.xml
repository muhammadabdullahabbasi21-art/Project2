<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="26dp">

        <ImageView
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:src="@android:drawable/ic_lock_lock"
            android:background="#D71920"
            android:padding="18dp"
            android:tint="#FFFFFF"
            android:contentDescription="Password recovery icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#B5121B"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your registered email address to start password recovery."
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/etRecoveryEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your email address"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="#D71920" />

        <Button
            android:id="@+id/btnRecoverPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CONTINUE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#D71920"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BACK TO LOGIN"
            android:textColor="#B5121B"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>

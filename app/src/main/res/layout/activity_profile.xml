<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY PROFILE"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#B5121B"
            android:layout_marginTop="30dp" />

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:text="👤"
            android:textSize="55sp"
            android:background="#FFDCDC"
            android:layout_marginTop="28dp"
            android:contentDescription="Donor profile icon" />

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: Donor"
            android:textColor="#333333"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:layout_marginTop="30dp" />

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email: donor@gmail.com"
            android:textColor="#333333"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvBloodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blood Group: Not provided"
            android:textColor="#333333"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnBackToDashboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BACK TO DASHBOARD"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#D71920"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LOGOUT"
            android:textColor="#B5121B"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
